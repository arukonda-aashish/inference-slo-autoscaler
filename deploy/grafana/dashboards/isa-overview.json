{
  "uid": "isa-overview",
  "title": "ISA — Inference SLO Autoscaler",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-10m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "TTFT vs GPU utilization — the thesis",
      "description": "If GPU utilization were a good scaling signal, these would move together.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:ttft:p95_30s", "legendFormat": "TTFT p95" },
        { "refId": "B", "expr": "isa:gpu_util:avg", "legendFormat": "GPU util %" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "GPU util %" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "percent" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "TTFT p95 / p99 vs SLO (2s)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:ttft:p95_30s", "legendFormat": "p95" },
        { "refId": "B", "expr": "isa:ttft:p99_30s", "legendFormat": "p99" },
        { "refId": "C", "expr": "isa:router_ttft:p95_30s", "legendFormat": "router-observed p95" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Queue: waiting and running",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:waiting:sum", "legendFormat": "waiting" },
        { "refId": "B", "expr": "isa:running:sum", "legendFormat": "running" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Queue slope (requests/s; positive = arrivals exceed service)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:waiting:slope30s", "legendFormat": "slope" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "KV cache usage (worst replica)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:kv_usage:max", "legendFormat": "kv usage" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "TPOT p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:tpot:p95_30s", "legendFormat": "TPOT p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Router: offered load vs responses",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "isa:arrival:rps30s", "legendFormat": "arrivals" },
        {
          "refId": "B",
          "expr": "sum by (code) (rate(router_requests_total[30s]))",
          "legendFormat": "responses {{code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Router in-flight by replica",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "router_inflight", "legendFormat": "{{replica}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    }
  ]
}